#. Plugin Name of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "OneTap Pro (for WordPress OneTap Pro - #1 Accessibility)"
msgstr "OneTap Pro (वर्डप्रेस OneTap Pro के लिए - #1 पहुंचयोग्यता)"

#. Plugin URI of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "https://wponetap.com"
msgstr "https://wponetap.com"

#. Description of the plugin
#: accessibility-plugin-onetap-pro.php
msgid ""
"OneTap is a multilingual WordPress plugin designed for seamless website "
"accessibility. With a simple one-click installation, it ensures your site "
"meets accessibility standards without any hassle. Built for performance, "
"providing an inclusive, user-friendly web environment for all visitors."
msgstr ""
"OneTap एक बहुभाषी वर्डप्रेस प्लगइन है जो निर्बाध वेबसाइट पहुंचयोग्यता के लिए डिज़ाइन किया "
"गया है। सरल एक-क्लिक इंस्टॉलेशन के साथ, यह सुनिश्चित करता है कि आपकी साइट बिना किसी "
"परेशानी के पहुंचयोग्यता मानकों को पूरा करती है। प्रदर्शन के लिए निर्मित, सभी आगंतुकों के लिए "
"एक समावेशी, उपयोगकर्ता-अनुकूल वेब वातावरण प्रदान करता है।"

