#. Plugin Name of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "OneTap Pro (for WordPress OneTap Pro - #1 Accessibility)"
msgstr "OneTap Pro (för WordPress OneTap Pro - #1 Tillgänglighet)"

#. Plugin URI of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "https://wponetap.com"
msgstr "https://wponetap.com"

#. Description of the plugin
#: accessibility-plugin-onetap-pro.php
msgid ""
"OneTap is a multilingual WordPress plugin designed for seamless website "
"accessibility. With a simple one-click installation, it ensures your site "
"meets accessibility standards without any hassle. Built for performance, "
"providing an inclusive, user-friendly web environment for all visitors."
msgstr ""
"OneTap är en flerspråkig WordPress-plugin utformad för sömlös "
"webbtillgänglighet. Med en enkel enklicksinstallation säkerställer den att "
"din webbplats uppfyller tillgänglighetsstandarder utan krångel. Byggd för "
"prestanda och ger en inkluderande, användarvänlig webbmiljö för alla "
"besökare."

