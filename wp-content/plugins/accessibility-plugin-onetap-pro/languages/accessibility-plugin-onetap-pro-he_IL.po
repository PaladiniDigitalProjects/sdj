msgid "OneTap Pro (for WordPress OneTap Pro - #1 Accessibility)"
msgstr "OneTap Pro (עבור WordPress OneTap Pro - נגישות #1)"

#. Plugin URI of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "https://wponetap.com"
msgstr "https://wponetap.com"

#. Description of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "OneTap is a multilingual WordPress plugin designed for seamless website accessibility. With a simple one-click installation, it ensures your site meets accessibility standards without any hassle. Built for performance, providing an inclusive, user-friendly web environment for all visitors."
msgstr "OneTap הוא תוסף WordPress רב-לשוני שנועד לנגישות אתר חלקה. עם התקנה פשוטה של לחיצה אחת, הוא מבטיח שהאתר שלך עומד בתקני נגישות ללא כל טרחה. בנוי לביצועים, ומספק סביבת אינטרנט כוללת וידידותית למשתמש עבור כל המבקרים."

