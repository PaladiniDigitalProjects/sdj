#. Plugin Name of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "OneTap Pro (for WordPress OneTap Pro - #1 Accessibility)"
msgstr "OneTap Pro (do WordPress OneTap Pro - #1 Inrochtaineacht)"

#. Plugin URI of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "https://wponetap.com"
msgstr "https://wponetap.com"

#. Description of the plugin
#: accessibility-plugin-onetap-pro.php
msgid ""
"OneTap is a multilingual WordPress plugin designed for seamless website "
"accessibility. With a simple one-click installation, it ensures your site "
"meets accessibility standards without any hassle. Built for performance, "
"providing an inclusive, user-friendly web environment for all visitors."
msgstr ""
"Is breiseán WordPress ilteangach é OneTap atá deartha chun inrochtaineacht "
"láithreán gréasáin gan stró a chinntiú. Le suiteáil simplí aon-chliceála, "
"cinntíonn sé go gcomhlíonann do shuíomh caighdeáin inrochtaineachta gan aon "
"trioblóid. Tógtha ar mhaithe le feidhmíocht, ag soláthar timpeallacht "
"ghréasáin chuimsitheach agus atá cairdiúil d'úsáideoirí do gach cuairteoir."

