#. Plugin Name of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "OneTap Pro (for WordPress OneTap Pro - #1 Accessibility)"
msgstr "OneTap Pro (WordPress OneTap Pro – #1 akadálymentesítés)"

#. Plugin URI of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "https://wponetap.com"
msgstr "https://wponetap.com"

#. Description of the plugin
#: accessibility-plugin-onetap-pro.php
msgid ""
"OneTap is a multilingual WordPress plugin designed for seamless website "
"accessibility. With a simple one-click installation, it ensures your site "
"meets accessibility standards without any hassle. Built for performance, "
"providing an inclusive, user-friendly web environment for all visitors."
msgstr ""
"A OneTap egy többnyelvű WordPress-bővítmény, amelyet a weboldal "
"zökkenőmentes akadálymentesítésére terveztek. Egyszerű, egykattintásos "
"telepítéssel biztosítja, hogy webhelye megfeleljen az akadálymentességi "
"szabványoknak. Teljesítményre építve minden látogató számára befogadó, "
"felhasználóbarát webes környezetet nyújt."

