#. Plugin Name of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "OneTap Pro (for WordPress OneTap Pro - #1 Accessibility)"
msgstr "OneTap Pro (for WordPress OneTap Pro - #1 Tilgjengelighet)"

#. Plugin URI of the plugin
#: accessibility-plugin-onetap-pro.php
msgid "https://wponetap.com"
msgstr "https://wponetap.com"

#. Description of the plugin
#: accessibility-plugin-onetap-pro.php
msgid ""
"OneTap is a multilingual WordPress plugin designed for seamless website "
"accessibility. With a simple one-click installation, it ensures your site "
"meets accessibility standards without any hassle. Built for performance, "
"providing an inclusive, user-friendly web environment for all visitors."
msgstr ""
"OneTap er en flerspråklig WordPress-pluggin designet for sømløs "
"nettstedstilgjengelighet. Med en enkel ettklikks-installasjon sikrer den at "
"nettstedet ditt oppfyller tilgjengelighetsstandarder uten problemer. Bygget "
"for ytelse, gir en inkluderende, brukervennlig nettmiljø for alle besøkende."

