#. Plugin Name of the plugin
#: plugin.php
#: classes/Integrations/Base/Notice.php:148
#: classes/UI/AdminPageHooks.php:72
msgid "WPML Export and Import"
msgstr "WPML Export and Import"

#. Plugin URI of the plugin
#: plugin.php
msgid "https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpml-export-and-import/"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpml-export-and-import/"

#. Description of the plugin
#: plugin.php
msgid "A multipurpose plugin to export and import multilingual content."
msgstr "Çok dilli içeriği dışa aktarmak ve içe aktarmak için çok amaçlı bir eklenti."

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "http://www.onthegosystems.com"
msgstr "http://www.onthegosystems.com"

#. translators: Text of the page returned when the import trigger is called the old way, with the key in the address.
#: classes/API/Hooks.php:45
msgid "The import trigger no longer accepts the key in the URL. Send it in a POST body."
msgstr "İçe aktarma tetikleyicisi artık URL içindeki anahtarı kabul etmiyor. Anahtarı bir POST gövdesinde gönderin."

#. translators: Title of the page returned when the import trigger is called the old way, with the key in the address. It is the name of HTTP status 405.
#: classes/API/Hooks.php:47
msgid "Method Not Allowed"
msgstr "Yönteme İzin Verilmedi"

#. translators: Text and title of the page returned when the import trigger is called with a wrong or missing key. It is the name of HTTP status 401.
#: classes/API/Hooks.php:61
#: classes/API/Hooks.php:62
msgid "Unauthorized"
msgstr "Yetkisiz"

#. translators: Text of the page returned when the import trigger runs and there is nothing left to import.
#: classes/API/Hooks.php:70
msgid "No items to process"
msgstr "İşlenecek öge yok"

#. translators: Title of the page returned when the import trigger runs and there is nothing left to import. It is the name of HTTP status 204.
#: classes/API/Hooks.php:72
msgid "No Content"
msgstr "İçerik yok"

#. translators: Text of the page returned when the import trigger has finished running.
#: classes/API/Hooks.php:82
msgid "Import process completed"
msgstr "İçe aktarma işlemi tamamlandı"

#. translators: Title of the page returned when the import trigger has finished running. It is the name of HTTP status 200.
#: classes/API/Hooks.php:84
msgid "Success"
msgstr "Başarılı"

#. translators: Text of the page returned when the import trigger stopped on an error.
#: classes/API/Hooks.php:95
msgid "Import process failed"
msgstr "İçe aktarma işlemi başarısız oldu"

#. translators: Title of the page returned when the import trigger stopped on an error. It is the name of HTTP status 500.
#: classes/API/Hooks.php:97
msgid "Internal Server Error"
msgstr "Sunucu hatası"

#. translators: Warning printed by the WP-CLI import command when a step could not finish. %1$s: the name of the import step, for example "Updating Final Post Status". %2$d: the number of items that were left unprocessed.
#: classes/CLI/Commands.php:63
#, php-format
msgid "%1$s: %2$d item could not be processed and was skipped."
msgid_plural "%1$s: %2$d items could not be processed and were skipped."
msgstr[0] "%1$s: %2$d öge işlenemedi ve atlandı."
msgstr[1] "%1$s: %2$d öge işlenemedi ve atlandı."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/CleanupPostFields.php:12
msgid "Cleaning Up Post Data"
msgstr "Yazı verileri temizleniyor"

#: classes/Commands/CleanupPostFields.php:19
msgid "Removing temporary and import-related post meta data."
msgstr "Geçici ve içe aktarma ile ilgili yazı meta verileri kaldırılıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/CleanupTermFields.php:12
msgid "Cleaning Up Term Data"
msgstr "Terim verileri temizleniyor"

#: classes/Commands/CleanupTermFields.php:19
msgid "Removing temporary and import-related term meta data."
msgstr "Geçici ve içe aktarma ile ilgili terim meta verileri kaldırılıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/ConnectPostImageAttachments.php:39
msgid "Connecting Post Image Attachments"
msgstr "Yazı görsel ekleri bağlanıyor"

#: classes/Commands/ConnectPostImageAttachments.php:46
msgid "Updating thumbnail and gallery attachment IDs on translated posts, products, and CPTs to point to their translated equivalents."
msgstr "Çevrilmiş yazılar, ürünler ve özel yazı türlerindeki (CPT) öne çıkan görsel ve galeri eki ID'leri, çevrilmiş karşılıklarını gösterecek şekilde güncelleniyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/ConnectTermTranslationsByPostsWithOnlyOneAssignment.php:45
msgid "Connecting Inline Term Translations"
msgstr "Satır içi terim çevirileri bağlanıyor"

#: classes/Commands/ConnectTermTranslationsByPostsWithOnlyOneAssignment.php:52
msgid "Scanning posts with a single taxonomy term in order to identify and connect the terms assigned to these posts with their translations."
msgstr "Bu yazılara atanan terimleri tanımlamak ve çevirileriyle bağlamak için tek bir taksonomi terimine sahip yazılar taranıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/DeleteOriginalsOfDuplicatedTerms.php:30
msgid "Deleting Obsolete Original Terms"
msgstr "Kullanımdan kalkan orijinal terimler siliniyor"

#: classes/Commands/DeleteOriginalsOfDuplicatedTerms.php:37
msgid "Removing original terms that are no longer needed after creating duplicates for same-named terms. Ensuring no posts are linked to these original terms."
msgstr "Aynı isimli terimler için kopyalar oluşturulduktan sonra artık ihtiyaç duyulmayan orijinal terimler kaldırılıyor. Bu orijinal terimlere hiçbir yazının bağlı olmadığından emin olunuyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/DuplicateTermsAssignedToPostsInDifferentLanguage.php:56
msgid "Duplicating Terms with Shared Names Across Languages"
msgstr "Diller arasında paylaşılan isimlere sahip terimler çoğaltılıyor"

#: classes/Commands/DuplicateTermsAssignedToPostsInDifferentLanguage.php:63
msgid "Creating duplicates in the correct language for terms that share the same name across languages, but belong to posts in different languages."
msgstr "Diller arasında aynı ismi paylaşan ancak farklı dillerdeki yazılara ait olan terimler için doğru dilde kopyalar oluşturuluyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/FixImportedPostSlugs.php:30
msgid "Fixing Imported Post Slugs"
msgstr "İçe aktarılan yazı adres son ekleri düzeltiliyor"

#: classes/Commands/FixImportedPostSlugs.php:34
msgid "Regenerating translated post slugs to prevent conflicts with the originals."
msgstr "Orijinallerle çakışmaları önlemek için çevrilmiş yazı adres son ekleri yeniden oluşturuluyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/FlushTranslationsCache.php:11
msgid "Clearing Translations Cache"
msgstr "Çeviri önbelleği temizleniyor"

#. translators: Description of the "Clearing Translations Cache" import step, shown under the step name; "it" is the cache.
#: classes/Commands/FlushTranslationsCache.php:16
msgid "Invalidating the persistent cache so it can be regenerated."
msgstr "Yeniden oluşturulabilmesi için kalıcı önbellek geçersiz kılınıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/MarkAncestorsForParentLanguageFix.php:42
msgid "Marking Parent Terms for Connection"
msgstr "Üst terimler bağlantı için işaretleniyor"

#. translators: Description of the "Marking Parent Terms for Connection" import step, shown under the step name; "their" refers to the parent terms.
#: classes/Commands/MarkAncestorsForParentLanguageFix.php:50
msgid "Collecting parent terms to connect their translations in the next step."
msgstr "Bir sonraki adımda çevirilerini bağlamak için üst terimler toplanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/ReassignPostsToTranslatedTerms.php:40
msgid "Connecting Posts with Correct Term Translations"
msgstr "Yazılar doğru terim çevirileriyle bağlanıyor"

#: classes/Commands/ReassignPostsToTranslatedTerms.php:47
msgid "Ensuring posts are connected to terms in the correct language, especially if you have the same term names across languages."
msgstr "Özellikle diller arasında aynı terim isimlerine sahipseniz, yazıların doğru dildeki terimlere bağlanması sağlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SendPostsToAutomaticTranslation.php:44
msgid "Sending Posts for Automatic Translation"
msgstr "Yazılar otomatik çeviriye gönderiliyor"

#: classes/Commands/SendPostsToAutomaticTranslation.php:51
msgid "Creating automatic translation jobs for posts flagged for auto-translation in the exported data."
msgstr "Dışa aktarılan verilerde otomatik çeviri için işaretlenmiş yazılar için otomatik çeviri işleri oluşturuluyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetAttachmentsLanguage.php:34
msgid "Setting Attachments' Language"
msgstr "Eklerin dili ayarlanıyor"

#: classes/Commands/SetAttachmentsLanguage.php:41
msgid "Assigning a language to imported attachments."
msgstr "İçe aktarılan eklere bir dil atanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetFinalPostsStatus.php:39
msgid "Updating Final Post Status"
msgstr "Final yazı durumu güncelleniyor"

#: classes/Commands/SetFinalPostsStatus.php:46
msgid "Setting the post status based on the \"_wpml_import_after_process_post_status\" field from the import file (if provided)."
msgstr "Yazı durumu, içe aktarma dosyasındaki (sağlanmışsa) “_wpml_import_after_process_post_status” alanına göre ayarlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetInlineTermsLanguage.php:42
msgid "Identifying Inline Term Languages"
msgstr "Satır içi terim dilleri tanımlanıyor"

#: classes/Commands/SetInlineTermsLanguage.php:49
msgid "Identifying and setting the language of terms created during post imports."
msgstr "Yazı içe aktarmaları sırasında oluşturulan terimlerin dili tanımlanıyor ve ayarlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetPostsLanguage.php:17
msgid "Setting Posts’ Language"
msgstr "Yazıların dili ayarlanıyor"

#: classes/Commands/SetPostsLanguage.php:24
msgid "Connecting posts to the default language and translations."
msgstr "Yazılar varsayılan dile ve çevirilere bağlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetTermsLanguage.php:18
msgid "Setting Terms’ Language"
msgstr "Terimlerin dili ayarlanıyor"

#: classes/Commands/SetTermsLanguage.php:25
msgid "Connecting taxonomy terms to the default (original) language and translations."
msgstr "Taksonomi terimleri varsayılan (orijinal) dile ve çevirilere bağlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetUnassignedParentTermsLanguage.php:39
msgid "Setting Parent Terms' Language"
msgstr "Üst terimlerin dili ayarlanıyor"

#: classes/Commands/SetUnassignedParentTermsLanguage.php:46
msgid "Assigning language to parent taxonomy terms that don't have one, based on the language assigned to their children."
msgstr "Dili olmayan üst taksonomi terimlerine, alt ögelerine atanan dile göre dil atanıyor."

#. translators: Notice shown on the WordPress export screen. %s: a link to the WPML Export and Import documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:83
#, php-format
msgid "Migrating your multilingual site? Remember to also install %s on your new site before importing your content so we can restore all the translations."
msgstr "Çok dilli sitenizi mi taşıyorsunuz? Tüm çevirileri geri yükleyebilmemiz için içeriğinizi içe aktarmadan önce yeni sitenize %s eklentisini de kurmayı unutmayın."

#. translators: Notice shown on the WooCommerce product export screen when WooCommerce Multilingual is not installed. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:95
#, php-format
msgid "Migrating your multilingual shop? With %1$s and %2$s you can transfer your translated content to a new site, including cross-sells, up-sells, and product attributes."
msgstr "Çok dilli mağazanızı mı taşıyorsunuz? %1$s ve %2$s ile çapraz satışlar, üst satışlar ve ürün nitelikleri dahil olmak üzere çevrilmiş içeriğinizi yeni bir siteye aktarabilirsiniz."

#. translators: Notice shown on the WooCommerce product export screen when WooCommerce Multilingual is installed. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:102
#, php-format
msgid "Migrating your multilingual shop? Remember to install %1$s and %2$s on your new site before importing your content so we can restore all the translations."
msgstr "Çok dilli mağazanızı mı taşıyorsunuz? Tüm çevirileri geri yükleyebilmemiz için içeriğinizi içe aktarmadan önce yeni sitenize %1$s ve %2$s eklentilerini kurmayı unutmayın."

#. translators: Notice shown on the WordPress import screen. %s: a link to the WPML Export and Import documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:114
#, php-format
msgid "Looking to import your multilingual content? Remember to install %s in your original site before exporting its content so we can import all the translations here."
msgstr "Çok dilli içeriğinizi içe aktarmak mı istiyorsunuz? Buradaki tüm çevirileri içe aktarabilmemiz için içeriğini dışa aktarmadan önce orijinal sitenize %s eklentisini kurmayı unutmayın."

#. translators: First line of the notice shown on the WooCommerce product import screen when WooCommerce Multilingual is not installed; a second line follows it. %1$s: a link to the WooCommerce Multilingual documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:126
#, php-format
msgid "Looking to import your multilingual content? Install %1$s on this site."
msgstr "Çok dilli içeriğinizi içe aktarmak mı istiyorsunuz? Bu siteye %1$s kurun."

#. translators: Second line of the notice shown on the WooCommerce product import screen when WooCommerce Multilingual is not installed; the numbering continues from the first line. %2$s: a link to the WooCommerce Multilingual documentation, %3$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:129
#, php-format
msgid "Remember to also enable %2$s and %3$s in your original shop before exporting its content so we can import all the translations here."
msgstr "Buradaki tüm çevirileri içe aktarabilmemiz için içeriğini dışa aktarmadan önce orijinal mağazanızda %2$s ve %3$s eklentilerini de etkinleştirmeyi unutmayın."

#. translators: Notice shown on the WooCommerce product import screen when WooCommerce Multilingual is installed. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:137
#, php-format
msgid "Looking to import your multilingual content? Remember to enable %1$s and %2$s in your original shop before exporting its content so we can import all the translations here."
msgstr "Çok dilli içeriğinizi içe aktarmak mı istiyorsunuz? Buradaki tüm çevirileri içe aktarabilmemiz için içeriğini dışa aktarmadan önce orijinal mağazanızda %1$s ve %2$s eklentilerini etkinleştirmeyi unutmayın."

#. translators: Name of the WooCommerce Multilingual plugin, used as the text and the tooltip of a link to its documentation. Keep the product name in English.
#: classes/Integrations/Base/Notice.php:160
msgid "WooCommerce Multilingual"
msgstr "WooCommerce Multilingual"

#: classes/Integrations/Base/Notice.php:178
msgid "Switch to all languages"
msgstr "Tüm dillere geç"

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/Commands/ConnectAttributesUsedInProductVariations.php:42
msgid "Linking Product Attribute Translations"
msgstr "Ürün niteliği çevirileri bağlanıyor"

#. translators: Description of the "Linking Product Attribute Translations" import step, shown under the step name; "their" refers to the product attributes.
#: classes/Integrations/WooCommerce/Commands/ConnectAttributesUsedInProductVariations.php:50
msgid "Connecting product attributes to their translations based on associated product variations."
msgstr "Ürün nitelikleri, ilişkili ürün varyasyonlarına göre çevirilerine bağlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/Commands/ConnectRelatedProducts.php:59
msgid "Updating Related Products On Translations"
msgstr "Çevirilerdeki ilgili ürünler güncelleniyor"

#: classes/Integrations/WooCommerce/Commands/ConnectRelatedProducts.php:66
msgid "Setting up-sells, cross-sells and grouped products references in the right language."
msgstr "Üst satışlar, çapraz satışlar ve gruplandırılmış ürün referansları doğru dilde ayarlanıyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/Commands/ProcessLocalAttributeLabels.php:29
msgid "Importing Custom Attribute Labels"
msgstr "Özel nitelik etiketleri içe aktarılıyor"

#: classes/Integrations/WooCommerce/Commands/ProcessLocalAttributeLabels.php:36
msgid "Importing labels for product-specific (custom) attributes from the exported data."
msgstr "Dışa aktarılan verilerden ürüne özel (özel) nitelikler için etiketler içe aktarılıyor."

#: classes/Integrations/WooCommerce/ExportNotice.php:40
msgid "You are about to export all your products in all languages at once."
msgstr "Tüm ürünlerinizi tüm dillerde aynı anda dışa aktarmak üzeresiniz."

#. translators: Line of the notice shown on the WooCommerce product export screen. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/WooCommerce/ExportNotice.php:44
#: classes/Integrations/WooCommerce/ExportNotice.php:51
#, php-format
msgid "Remember to install %1$s and %2$s on your new site before importing your content so we can restore all the translations."
msgstr "Tüm çevirileri geri yükleyebilmemiz için içeriğinizi içe aktarmadan önce yeni sitenize %1$s ve %2$s eklentilerini kurmayı unutmayın."

#. translators: Line of the notice shown on the WooCommerce product export screen. %s: the name of the language the products will be exported in, shown in bold.
#: classes/Integrations/WooCommerce/ExportNotice.php:58
#, php-format
msgid "You are about to export your products in %s."
msgstr "Ürünlerinizi %s dilinde dışa aktarmak üzeresiniz."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/WCML/Commands/RegisterAttributesAsTranslatableTaxonomies.php:31
msgid "Registering Product Attributes"
msgstr "Ürün nitelikleri kaydediliyor"

#: classes/Integrations/WooCommerce/WCML/Commands/RegisterAttributesAsTranslatableTaxonomies.php:38
msgid "Identifying and registering attributes created during product imports for translation."
msgstr "Ürün içe aktarmaları sırasında oluşturulan nitelikler çeviri için tanımlanıyor ve kaydediliyor."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/WCML/Commands/SetAttributesLanguage.php:45
msgid "Identifying Product Attribute Languages"
msgstr "Ürün nitelik dilleri tanımlanıyor"

#: classes/Integrations/WooCommerce/WCML/Commands/SetAttributesLanguage.php:52
msgid "Identifying and setting the language of attributes created during product imports."
msgstr "Ürün içe aktarmaları sırasında oluşturulan niteliklerin dili tanımlanıyor ve ayarlanıyor."

#. translators: Item in the WPML menu in the WordPress admin, opening the export and import screen. A noun phrase naming the screen, not an instruction.
#: classes/UI/AdminPageHooks.php:49
msgid "Export and Import"
msgstr "Dışa aktar ve içe aktar"

#. translators: Option in the list of ways to create the content to import, on the WPML Export and Import screen. The user speaks in the first person. %s: the name of the tool, for example "WordPress" or "WooCommerce".
#: classes/UI/AdminPageHooks.php:151
#, php-format
msgid "I’m using the built-in %s export/import tool"
msgstr "Yerleşik %s dışa/içe aktarma aracını kullanıyorum"

#. translators: Option in the list of ways to create the content to import, on the WPML Export and Import screen. The user speaks in the first person. %s: the name of the plugin, for example "WP Import Export".
#: classes/UI/AdminPageHooks.php:156
#, php-format
msgid "I’m using %s plugin"
msgstr "%s eklentisini kullanıyorum"

#. translators: Progress shown next to an import step on the WPML Export and Import screen. %1$d: the number of items already processed, %2$d: the total number of items. Keep the parentheses.
#: classes/UI/AdminPageHooks.php:161
#, php-format
msgid "(%1$d/%2$d items)"
msgstr "(%1$d/%2$d öge)"

#. translators: Shown next to an import step that left items behind, on the WPML Export and Import screen. %d: the number of items that were skipped.
#: classes/UI/AdminPageHooks.php:163
#, php-format
msgid "%d skipped"
msgstr "%d atlandı"

#. translators: Shown instead of a count next to an import step that has nothing to process, on the WPML Export and Import screen. Keep the parentheses.
#: classes/UI/AdminPageHooks.php:165
msgid "(no items)"
msgstr "(öge yok)"

#. translators: Shown next to an import step while it counts how much there is to process, on the WPML Export and Import screen.
#: classes/UI/AdminPageHooks.php:167
msgid "Counting items..."
msgstr "Ögeler sayılıyor..."

#: classes/UI/AdminPageHooks.php:169
msgid "First, tell us how you’re going to create the content that you’ll be importing:"
msgstr "Öncelikle, içe aktaracağınız içeriği nasıl oluşturacağınızı belirtin:"

#. translators: Button label that moves to the next question on the WPML Export and Import screen. Verb, imperative.
#: classes/UI/AdminPageHooks.php:171
msgid "Continue"
msgstr "Devam Et"

#. translators: Option in the list of ways to create the content to import, on the WPML Export and Import screen. The user speaks in the first person. %1$s and %2$s: the names of the two plugins used together.
#: classes/UI/AdminPageHooks.php:176
#, php-format
msgid "I’m using %1$s and %2$s plugins"
msgstr "%1$s ve %2$s eklentilerini kullanıyorum"

#. translators: Option in the list of ways to create the content to import, on the WPML Export and Import screen. The user speaks in the first person.
#: classes/UI/AdminPageHooks.php:179
msgid "I’m using a different method to export from this site"
msgstr "Bu siteden dışa aktarmak için farklı bir yöntem kullanıyorum"

#. translators: Option answering where the content to import comes from, on the WPML Export and Import screen. The user speaks in the first person.
#: classes/UI/AdminPageHooks.php:182
msgid "I’m exporting the content from this site"
msgstr "İçeriği bu siteden dışa aktarıyorum"

#: classes/UI/AdminPageHooks.php:183
msgid "I’m exporting the content from a different website or system"
msgstr "İçeriği farklı bir web sitesinden veya sistemden dışa aktarıyorum"

#: classes/UI/AdminPageHooks.php:184
msgid "Before importing, add language columns to your content"
msgstr "İçe aktarmadan önce içeriğinize dil sütunları ekleyin"

#: classes/UI/AdminPageHooks.php:185
msgid "Make sure that your import file includes the following columns (custom fields) with language information:"
msgstr "İçe aktarma dosyanızın dil bilgilerini içeren aşağıdaki sütunları (özel alanları) içerdiğinden emin olun:"

#. translators: Item in the list of columns the import file must have, on the WPML Export and Import screen. %s: the name of the column, shown in bold.
#: classes/UI/AdminPageHooks.php:188
#, php-format
msgid "%s: A value that’s the same for all the translations of each item. In e-commerce sites this will often be the SKU."
msgstr "%s: Her ögenin tüm çevirileri için aynı olan bir değer. E-ticaret sitelerinde bu genellikle SKU olacaktır."

#. translators: Item in the list of columns the import file must have, on the WPML Export and Import screen. %s: the name of the column, shown in bold.
#: classes/UI/AdminPageHooks.php:190
#, php-format
msgid "%s: The language code for each item."
msgstr "%s: Her öge için dil kodu."

#. translators: Sentence introducing the list of optional import file columns, on the WPML Export and Import screen.
#: classes/UI/AdminPageHooks.php:194
msgid "And, you can include these two columns if needed:"
msgstr "Ve gerekirse şu iki sütunu da ekleyebilirsiniz:"

#. translators: Item in the list of columns the import file can also have, on the WPML Export and Import screen. %s: the name of the column, shown in bold.
#: classes/UI/AdminPageHooks.php:197
#, php-format
msgid "%s: If this item is a translation, set this column to the code of the source language. If it’s not a translation, keep it empty."
msgstr "%s: Bu öge bir çeviriyse, bu sütunu kaynak dilin koduna ayarlayın. Eğer bir çeviri değilse boş bırakın."

#. translators: Item in the list of columns the import file can also have, on the WPML Export and Import screen. %s: the name of the column, shown in bold.
#: classes/UI/AdminPageHooks.php:199
#, php-format
msgid "%s: Set to “draft” or “published” to determine the publishing status of the post after adjusting languages. Usually, this value will be “published”."
msgstr "%s: Dilleri ayarladıktan sonra yazının yayımlanma durumunu belirlemek için “draft” veya “published” olarak ayarlayın. Genellikle bu değer “published” olacaktır."

#. translators: Sentence introducing an example import file, on the WPML Export and Import screen. %s: the site's languages, as a comma-separated list.
#: classes/UI/AdminPageHooks.php:203
#, php-format
msgid "Here is an example of importing two items, into your site’s languages (%s):"
msgstr "İşte iki ögenin sitenizin (%s) dillerine içe aktarılmasına dair bir örnek:"

#: classes/UI/AdminPageHooks.php:205
msgid "Once you’ve added language columns to your multilingual content file, import it to your site using whatever import plugin you prefer."
msgstr "Çok dilli içerik dosyanıza dil sütunlarını ekledikten sonra, tercih ettiğiniz herhangi bir içe aktarma eklentisini kullanarak sitenize aktarın."

#: classes/UI/AdminPageHooks.php:206
msgid "Before importing, your content needs language information"
msgstr "İçe aktarmadan önce içeriğinizin dil bilgisine ihtiyacı var"

#. translators: Heading of step 1 on the WPML Export and Import screen. %s: the name of the WPML Export and Import plugin.
#: classes/UI/AdminPageHooks.php:208
#, php-format
msgid "%s will add the necessary language information to your export."
msgstr "%s dışa aktarma işleminize gerekli dil bilgilerini ekleyecektir."

#: classes/UI/AdminPageHooks.php:209
msgid "Import your multilingual content file into the site using whatever import plugin you prefer."
msgstr "Tercih ettiğiniz herhangi bir içe aktarma eklentisini kullanarak çok dilli içerik dosyanızı siteye aktarın."

#. translators: Heading of step 2 on the WPML Export and Import screen. Verb, imperative.
#: classes/UI/AdminPageHooks.php:211
msgid "Use your favorite import plugin"
msgstr "Favori içe aktarma eklentinizi kullanın"

#: classes/UI/AdminPageHooks.php:212
msgid "After you import the content, it will still not show the correct language information. So, we recommend that you import new content as Drafts. If you’re importing updates, you can keep already-published content as published."
msgstr "İçeriği içe aktardıktan sonra, içerik hala doğru dil bilgilerini göstermeyecektir. Bu nedenle, yeni içeriği Taslak olarak içe aktarmanızı öneririz. Güncellemeleri içe aktarıyorsanız, halihazırda yayımlanmış içeriği yayımlanmış olarak tutabilirsiniz."

#. translators: Title of step 3 on the WPML Export and Import screen. %s: the name of the WPML Export and Import plugin.
#: classes/UI/AdminPageHooks.php:214
#, php-format
msgid "Return here, to %s, to set languages and connect translations"
msgstr "Dilleri ayarlamak ve çevirileri bağlamak için buraya, %s ekranına dönün"

#. translators: Text of step 3 on the WPML Export and Import screen. %s: the name of the WPML Export and Import plugin.
#: classes/UI/AdminPageHooks.php:216
#, php-format
msgid "When you visit this page after you’ve imported content with language information, you’ll be able to run %s to apply languages and connect translations."
msgstr "Dil bilgisi içeren içeriği içe aktardıktan sonra bu sayfayı ziyaret ettiğinizde, dilleri uygulamak ve çevirileri bağlamak için %s eklentisini çalıştırabileceksiniz."

#. translators: Last line of step 3 on the WPML Export and Import screen. %1$s: opening link tag, %2$s: the name of the WPML Export and Import plugin, %3$s: closing link tag.
#: classes/UI/AdminPageHooks.php:220
#, php-format
msgid "Already imported and still seeing this screen? %1$sTroubleshooting %2$s%3$s."
msgstr "Zaten içe aktardınız ve hala bu ekranı mı görüyorsunuz? %1$sSorun Giderme %2$s%3$s."

#: classes/UI/AdminPageHooks.php:227
msgid "How to Export and Import Content in Multiple Languages"
msgstr "Birden çok dilde içerik nasıl dışa aktarılır ve içe aktarılır"

#. translators: Title of the WPML Export and Import screen once content has been imported. %s: the name of the WPML Export and Import plugin.
#: classes/UI/AdminPageHooks.php:229
#, php-format
msgid "%s is ready to update your imported content"
msgstr "%s içe aktarılan içeriğinizi güncellemeye hazır"

#. translators: Text on the WPML Export and Import screen, above the list of import steps. %1$d: the number of imported terms, %2$d: the number of imported posts.
#: classes/UI/AdminPageHooks.php:232
#, php-format
msgid "Good job. We see %1$d terms and %2$d posts that are imported and need language information."
msgstr "Tebrikler. İçe aktarılan ve dil bilgisine ihtiyaç duyan %1$d terim ve %2$d yazı görüyoruz."

#. translators: Text on the WPML Export and Import screen, above the list of import steps. %d: the number of imported terms.
#: classes/UI/AdminPageHooks.php:235
#, php-format
msgid "Good job. We see %d terms that are imported and need language information."
msgstr "Tebrikler. İçe aktarılan ve dil bilgisine ihtiyaç duyan %d terim görüyoruz."

#. translators: Text on the WPML Export and Import screen, above the list of import steps. %d: the number of imported posts.
#: classes/UI/AdminPageHooks.php:237
#, php-format
msgid "Good job. We see %d posts that are imported and need language information."
msgstr "Tebrikler. İçe aktarılan ve dil bilgisine ihtiyaç duyan %d yazı görüyoruz."

#. translators: Button label on the WPML Export and Import screen that starts the import steps. Verb, imperative; "WPML Import" is the name of the plugin.
#: classes/UI/AdminPageHooks.php:240
msgid "Run WPML Import"
msgstr "WPML Import'u çalıştır"

#. translators: Heading shown on the WPML Export and Import screen once every import step has finished. A noun phrase, not an instruction.
#: classes/UI/AdminPageHooks.php:242
msgid "Multilingual Import Complete"
msgstr "Çok dilli içe aktarma tamamlandı"
