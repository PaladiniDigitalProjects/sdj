#. Plugin Name of the plugin
#: plugin.php
#: classes/Integrations/Base/Notice.php:148
#: classes/UI/AdminPageHooks.php:72
msgid "WPML Export and Import"
msgstr "WPML Export and Import"

#. Plugin URI of the plugin
#: plugin.php
msgid "https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpml-export-and-import/"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpml-export-and-import/"

#. Description of the plugin
#: plugin.php
msgid "A multipurpose plugin to export and import multilingual content."
msgstr "Wielozadaniowa wtyczka do eksportu i importu treści wielojęzycznych."

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "http://www.onthegosystems.com"
msgstr "http://www.onthegosystems.com"

#. translators: Text of the page returned when the import trigger is called the old way, with the key in the address.
#: classes/API/Hooks.php:45
msgid "The import trigger no longer accepts the key in the URL. Send it in a POST body."
msgstr "Wyzwalacz importu nie akceptuje już klucza w adresie URL. Wyślij go w treści żądania (body) POST."

#. translators: Title of the page returned when the import trigger is called the old way, with the key in the address. It is the name of HTTP status 405.
#: classes/API/Hooks.php:47
msgid "Method Not Allowed"
msgstr "Niedozwolona metoda"

#. translators: Text and title of the page returned when the import trigger is called with a wrong or missing key. It is the name of HTTP status 401.
#: classes/API/Hooks.php:61
#: classes/API/Hooks.php:62
msgid "Unauthorized"
msgstr "Brak autoryzacji"

#. translators: Text of the page returned when the import trigger runs and there is nothing left to import.
#: classes/API/Hooks.php:70
msgid "No items to process"
msgstr "Brak elementów do przetworzenia"

#. translators: Title of the page returned when the import trigger runs and there is nothing left to import. It is the name of HTTP status 204.
#: classes/API/Hooks.php:72
msgid "No Content"
msgstr "Brak treści"

#. translators: Text of the page returned when the import trigger has finished running.
#: classes/API/Hooks.php:82
msgid "Import process completed"
msgstr "Proces importu zakończony"

#. translators: Title of the page returned when the import trigger has finished running. It is the name of HTTP status 200.
#: classes/API/Hooks.php:84
msgid "Success"
msgstr "Sukces"

#. translators: Text of the page returned when the import trigger stopped on an error.
#: classes/API/Hooks.php:95
msgid "Import process failed"
msgstr "Proces importu nie powiódł się"

#. translators: Title of the page returned when the import trigger stopped on an error. It is the name of HTTP status 500.
#: classes/API/Hooks.php:97
msgid "Internal Server Error"
msgstr "Wewnętrzny błąd serwera"

#. translators: Warning printed by the WP-CLI import command when a step could not finish. %1$s: the name of the import step, for example "Updating Final Post Status". %2$d: the number of items that were left unprocessed.
#: classes/CLI/Commands.php:63
#, php-format
msgid "%1$s: %2$d item could not be processed and was skipped."
msgid_plural "%1$s: %2$d items could not be processed and were skipped."
msgstr[0] "%1$s: %2$d element nie mógł zostać przetworzony i został pominięty."
msgstr[1] "%1$s: %2$d elementy nie mogły zostać przetworzone i zostały pominięte."
msgstr[2] "%1$s: %2$d elementów nie mogło zostać przetworzonych i zostało pominiętych."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/CleanupPostFields.php:12
msgid "Cleaning Up Post Data"
msgstr "Oczyszczanie danych wpisów"

#: classes/Commands/CleanupPostFields.php:19
msgid "Removing temporary and import-related post meta data."
msgstr "Usuwanie tymczasowych i związanych z importem metadanych wpisów."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/CleanupTermFields.php:12
msgid "Cleaning Up Term Data"
msgstr "Oczyszczanie danych terminów"

#: classes/Commands/CleanupTermFields.php:19
msgid "Removing temporary and import-related term meta data."
msgstr "Usuwanie tymczasowych i związanych z importem metadanych terminów."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/ConnectPostImageAttachments.php:39
msgid "Connecting Post Image Attachments"
msgstr "Łączenie załączników obrazów wpisów"

#: classes/Commands/ConnectPostImageAttachments.php:46
msgid "Updating thumbnail and gallery attachment IDs on translated posts, products, and CPTs to point to their translated equivalents."
msgstr "Aktualizowanie identyfikatorów ID załączników miniatur i galerii w przetłumaczonych wpisach, produktach i własnych typach wpisów (CPT), aby wskazywały na ich przetłumaczone odpowiedniki."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/ConnectTermTranslationsByPostsWithOnlyOneAssignment.php:45
msgid "Connecting Inline Term Translations"
msgstr "Łączenie tłumaczeń terminów w treści"

#: classes/Commands/ConnectTermTranslationsByPostsWithOnlyOneAssignment.php:52
msgid "Scanning posts with a single taxonomy term in order to identify and connect the terms assigned to these posts with their translations."
msgstr "Skanowanie wpisów z pojedynczym terminem taksonomii w celu zidentyfikowania i połączenia terminów przypisanych do tych wpisów z ich tłumaczeniami."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/DeleteOriginalsOfDuplicatedTerms.php:30
msgid "Deleting Obsolete Original Terms"
msgstr "Usuwanie przestarzałych terminów oryginalnych"

#: classes/Commands/DeleteOriginalsOfDuplicatedTerms.php:37
msgid "Removing original terms that are no longer needed after creating duplicates for same-named terms. Ensuring no posts are linked to these original terms."
msgstr "Usuwanie oryginalnych terminów, które nie są już potrzebne po utworzeniu duplikatów dla terminów o tej samej nazwie. Zapewnienie, że żadne wpisy nie są powiązane z tymi oryginalnymi terminami."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/DuplicateTermsAssignedToPostsInDifferentLanguage.php:56
msgid "Duplicating Terms with Shared Names Across Languages"
msgstr "Duplikowanie terminów o wspólnych nazwach w różnych językach"

#: classes/Commands/DuplicateTermsAssignedToPostsInDifferentLanguage.php:63
msgid "Creating duplicates in the correct language for terms that share the same name across languages, but belong to posts in different languages."
msgstr "Tworzenie duplikatów w odpowiednim języku dla terminów, które mają tę samą nazwę w różnych językach, ale należą do wpisów w różnych językach."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/FixImportedPostSlugs.php:30
msgid "Fixing Imported Post Slugs"
msgstr "Naprawianie uproszczonych nazw (slugów) zaimportowanych wpisów"

#: classes/Commands/FixImportedPostSlugs.php:34
msgid "Regenerating translated post slugs to prevent conflicts with the originals."
msgstr "Regenerowanie uproszczonych nazw (slugów) przetłumaczonych wpisów, aby zapobiec konfliktom z oryginałami."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/FlushTranslationsCache.php:11
msgid "Clearing Translations Cache"
msgstr "Czyszczenie pamięci podręcznej tłumaczeń"

#. translators: Description of the "Clearing Translations Cache" import step, shown under the step name; "it" is the cache.
#: classes/Commands/FlushTranslationsCache.php:16
msgid "Invalidating the persistent cache so it can be regenerated."
msgstr "Unieważnianie trwałej pamięci podręcznej, aby mogła zostać zregenerowana."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/MarkAncestorsForParentLanguageFix.php:42
msgid "Marking Parent Terms for Connection"
msgstr "Oznaczanie terminów nadrzędnych do połączenia"

#. translators: Description of the "Marking Parent Terms for Connection" import step, shown under the step name; "their" refers to the parent terms.
#: classes/Commands/MarkAncestorsForParentLanguageFix.php:50
msgid "Collecting parent terms to connect their translations in the next step."
msgstr "Zbieranie terminów nadrzędnych w celu połączenia ich tłumaczeń w następnym kroku."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/ReassignPostsToTranslatedTerms.php:40
msgid "Connecting Posts with Correct Term Translations"
msgstr "Łączenie wpisów z prawidłowymi tłumaczeniami terminów"

#: classes/Commands/ReassignPostsToTranslatedTerms.php:47
msgid "Ensuring posts are connected to terms in the correct language, especially if you have the same term names across languages."
msgstr "Zapewnienie, że wpisy są połączone z terminami w odpowiednim języku, zwłaszcza jeśli masz takie same nazwy terminów w różnych językach."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SendPostsToAutomaticTranslation.php:44
msgid "Sending Posts for Automatic Translation"
msgstr "Wysyłanie wpisów do automatycznego tłumaczenia"

#: classes/Commands/SendPostsToAutomaticTranslation.php:51
msgid "Creating automatic translation jobs for posts flagged for auto-translation in the exported data."
msgstr "Tworzenie zadań automatycznego tłumaczenia dla wpisów oznaczonych do automatycznego tłumaczenia w wyeksportowanych danych."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetAttachmentsLanguage.php:34
msgid "Setting Attachments' Language"
msgstr "Ustawianie języka załączników"

#: classes/Commands/SetAttachmentsLanguage.php:41
msgid "Assigning a language to imported attachments."
msgstr "Przypisywanie języka do zaimportowanych załączników."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetFinalPostsStatus.php:39
msgid "Updating Final Post Status"
msgstr "Aktualizowanie końcowego statusu wpisu"

#: classes/Commands/SetFinalPostsStatus.php:46
msgid "Setting the post status based on the \"_wpml_import_after_process_post_status\" field from the import file (if provided)."
msgstr "Ustawianie statusu wpisu na podstawie pola „_wpml_import_after_process_post_status” z pliku importu (jeśli zostało podane)."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetInlineTermsLanguage.php:42
msgid "Identifying Inline Term Languages"
msgstr "Identyfikowanie języków terminów w treści"

#: classes/Commands/SetInlineTermsLanguage.php:49
msgid "Identifying and setting the language of terms created during post imports."
msgstr "Identyfikowanie i ustawianie języka terminów utworzonych podczas importu wpisów."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetPostsLanguage.php:17
msgid "Setting Posts’ Language"
msgstr "Ustawianie języka wpisów"

#: classes/Commands/SetPostsLanguage.php:24
msgid "Connecting posts to the default language and translations."
msgstr "Łączenie wpisów z językiem domyślnym i tłumaczeniami."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetTermsLanguage.php:18
msgid "Setting Terms’ Language"
msgstr "Ustawianie języka terminów"

#: classes/Commands/SetTermsLanguage.php:25
msgid "Connecting taxonomy terms to the default (original) language and translations."
msgstr "Łączenie terminów taksonomii z domyślnym (oryginalnym) językiem i tłumaczeniami."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Commands/SetUnassignedParentTermsLanguage.php:39
msgid "Setting Parent Terms' Language"
msgstr "Ustawianie języka terminów nadrzędnych"

#: classes/Commands/SetUnassignedParentTermsLanguage.php:46
msgid "Assigning language to parent taxonomy terms that don't have one, based on the language assigned to their children."
msgstr "Przypisywanie języka do nadrzędnych terminów taksonomii, które go nie posiadają, na podstawie języka przypisanego do ich elementów podrzędnych."

#. translators: Notice shown on the WordPress export screen. %s: a link to the WPML Export and Import documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:83
#, php-format
msgid "Migrating your multilingual site? Remember to also install %s on your new site before importing your content so we can restore all the translations."
msgstr "Migrujesz swoją witrynę wielojęzyczną? Pamiętaj, aby przed zaimportowaniem treści zainstalować %s również w nowej witrynie, abyśmy mogli przywrócić wszystkie tłumaczenia."

#. translators: Notice shown on the WooCommerce product export screen when WooCommerce Multilingual is not installed. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:95
#, php-format
msgid "Migrating your multilingual shop? With %1$s and %2$s you can transfer your translated content to a new site, including cross-sells, up-sells, and product attributes."
msgstr "Migrujesz swój sklep wielojęzyczny? Dzięki %1$s i %2$s możesz przenieść przetłumaczoną treść do nowej witryny, w tym sprzedaż krzyżową, sprzedaż dodatkową i atrybuty produktów."

#. translators: Notice shown on the WooCommerce product export screen when WooCommerce Multilingual is installed. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:102
#, php-format
msgid "Migrating your multilingual shop? Remember to install %1$s and %2$s on your new site before importing your content so we can restore all the translations."
msgstr "Migrujesz swój sklep wielojęzyczny? Pamiętaj, aby przed zaimportowaniem treści zainstalować %1$s i %2$s w nowej witrynie, abyśmy mogli przywrócić wszystkie tłumaczenia."

#. translators: Notice shown on the WordPress import screen. %s: a link to the WPML Export and Import documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:114
#, php-format
msgid "Looking to import your multilingual content? Remember to install %s in your original site before exporting its content so we can import all the translations here."
msgstr "Chcesz zaimportować swoją wielojęzyczną treść? Pamiętaj, aby zainstalować %s w oryginalnej witrynie przed wyeksportowaniem jej treści, abyśmy mogli zaimportować tutaj wszystkie tłumaczenia."

#. translators: First line of the notice shown on the WooCommerce product import screen when WooCommerce Multilingual is not installed; a second line follows it. %1$s: a link to the WooCommerce Multilingual documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:126
#, php-format
msgid "Looking to import your multilingual content? Install %1$s on this site."
msgstr "Chcesz zaimportować swoją wielojęzyczną treść? Zainstaluj %1$s w tej witrynie."

#. translators: Second line of the notice shown on the WooCommerce product import screen when WooCommerce Multilingual is not installed; the numbering continues from the first line. %2$s: a link to the WooCommerce Multilingual documentation, %3$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:129
#, php-format
msgid "Remember to also enable %2$s and %3$s in your original shop before exporting its content so we can import all the translations here."
msgstr "Pamiętaj, aby przed wyeksportowaniem treści włączyć również %2$s i %3$s w oryginalnym sklepie, abyśmy mogli zaimportować tutaj wszystkie tłumaczenia."

#. translators: Notice shown on the WooCommerce product import screen when WooCommerce Multilingual is installed. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:137
#, php-format
msgid "Looking to import your multilingual content? Remember to enable %1$s and %2$s in your original shop before exporting its content so we can import all the translations here."
msgstr "Chcesz zaimportować swoją wielojęzyczną treść? Pamiętaj, aby przed wyeksportowaniem treści włączyć %1$s i %2$s w oryginalnym sklepie, abyśmy mogli zaimportować tutaj wszystkie tłumaczenia."

#. translators: Name of the WooCommerce Multilingual plugin, used as the text and the tooltip of a link to its documentation. Keep the product name in English.
#: classes/Integrations/Base/Notice.php:160
msgid "WooCommerce Multilingual"
msgstr "WooCommerce Multilingual"

#: classes/Integrations/Base/Notice.php:178
msgid "Switch to all languages"
msgstr "Przełącz na wszystkie języki"

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/Commands/ConnectAttributesUsedInProductVariations.php:42
msgid "Linking Product Attribute Translations"
msgstr "Łączenie tłumaczeń atrybutów produktów"

#. translators: Description of the "Linking Product Attribute Translations" import step, shown under the step name; "their" refers to the product attributes.
#: classes/Integrations/WooCommerce/Commands/ConnectAttributesUsedInProductVariations.php:50
msgid "Connecting product attributes to their translations based on associated product variations."
msgstr "Łączenie atrybutów produktów z ich tłumaczeniami na podstawie powiązanych wariantów produktów."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/Commands/ConnectRelatedProducts.php:59
msgid "Updating Related Products On Translations"
msgstr "Aktualizowanie powiązanych produktów w tłumaczeniach"

#: classes/Integrations/WooCommerce/Commands/ConnectRelatedProducts.php:66
msgid "Setting up-sells, cross-sells and grouped products references in the right language."
msgstr "Ustawianie odniesień do sprzedaży dodatkowej, sprzedaży krzyżowej i produktów grupowych w odpowiednim języku."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/Commands/ProcessLocalAttributeLabels.php:29
msgid "Importing Custom Attribute Labels"
msgstr "Importowanie własnych etykiet atrybutów"

#: classes/Integrations/WooCommerce/Commands/ProcessLocalAttributeLabels.php:36
msgid "Importing labels for product-specific (custom) attributes from the exported data."
msgstr "Importowanie etykiet dla atrybutów specyficznych dla produktu (własnych) z wyeksportowanych danych."

#: classes/Integrations/WooCommerce/ExportNotice.php:40
msgid "You are about to export all your products in all languages at once."
msgstr "Zamierzasz wyeksportować wszystkie swoje produkty we wszystkich językach naraz."

#. translators: Line of the notice shown on the WooCommerce product export screen. %1$s: a link to the WooCommerce Multilingual documentation, %2$s: a link to the WPML Export and Import documentation. Each link reads as the plugin's name.
#: classes/Integrations/WooCommerce/ExportNotice.php:44
#: classes/Integrations/WooCommerce/ExportNotice.php:51
#, php-format
msgid "Remember to install %1$s and %2$s on your new site before importing your content so we can restore all the translations."
msgstr "Pamiętaj, aby przed zaimportowaniem treści zainstalować %1$s i %2$s w nowej witrynie, abyśmy mogli przywrócić wszystkie tłumaczenia."

#. translators: Line of the notice shown on the WooCommerce product export screen. %s: the name of the language the products will be exported in, shown in bold.
#: classes/Integrations/WooCommerce/ExportNotice.php:58
#, php-format
msgid "You are about to export your products in %s."
msgstr "Zamierzasz wyeksportować swoje produkty w języku %s."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/WCML/Commands/RegisterAttributesAsTranslatableTaxonomies.php:31
msgid "Registering Product Attributes"
msgstr "Rejestrowanie atrybutów produktów"

#: classes/Integrations/WooCommerce/WCML/Commands/RegisterAttributesAsTranslatableTaxonomies.php:38
msgid "Identifying and registering attributes created during product imports for translation."
msgstr "Identyfikowanie i rejestrowanie do tłumaczenia atrybutów utworzonych podczas importu produktów."

#. translators: Name of a step in the list of steps WPML Export and Import runs, shown on its screen and by its WP-CLI command. A noun phrase naming what the step does, not an instruction to the user.
#: classes/Integrations/WooCommerce/WCML/Commands/SetAttributesLanguage.php:45
msgid "Identifying Product Attribute Languages"
msgstr "Identyfikowanie języków atrybutów produktów"

#: classes/Integrations/WooCommerce/WCML/Commands/SetAttributesLanguage.php:52
msgid "Identifying and setting the language of attributes created during product imports."
msgstr "Identyfikowanie i ustawianie języka atrybutów utworzonych podczas importu produktów."

#. translators: Item in the WPML menu in the WordPress admin, opening the export and import screen. A noun phrase naming the screen, not an instruction.
#: classes/UI/AdminPageHooks.php:49
msgid "Export and Import"
msgstr "Eksport i import"

#. translators: Option in the list of ways to create the content to import, on the WPML Export and Import screen. The user speaks in the first person. %s: the name of the tool, for example "WordPress" or "WooCommerce".
#: classes/UI/AdminPageHooks.php:151
#, php-format
msgid "I’m using the built-in %s export/import tool"
msgstr "Używam wbudowanego narzędzia do eksportu/importu %s"

#. translators: Option in the list of ways to create the content to import, on the WPML Export and Import screen. The user speaks in the first person. %s: the name of the plugin, for example "WP Import Export".
#: classes/UI/AdminPageHooks.php:156
#, php-format
msgid "I’m using %s plugin"
msgstr "Używam wtyczki %s"

#. translators: Progress shown next to an import step on the WPML Export and Import screen. %1$d: the number of items already processed, %2$d: the total number of items. Keep the parentheses.
#: classes/UI/AdminPageHooks.php:161
#, php-format
msgid "(%1$d/%2$d items)"
msgstr "(%1$d/%2$d elementów)"

#. translators: Shown next to an import step that left items behind, on the WPML Export and Import screen. %d: the number of items that were skipped.
