{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "pds-map-locations-filter/map-locations-filter",
    "title": "Map Locations Filter",
    "description": "Display a Google Map with filterable locations.",
    "category": "widgets",
    "icon": "location-alt",
    "keywords": [ "map", "locations", "filter", "Google Maps", "tienda" ],
    "textdomain": "pds-map-locations-filter",
    "attributes": {
        "title": {
            "type": "string",
            "default": "Nuestras Ubicaciones"
        },
         "selectedTaxonomies": {
             "type": "array",
             "default": [],
             "items": {
                 "type": "string"
             }
         },
        "initialCenter": {
            "type": "object",
            "default": {
                "lat": 40.416775,
                "lng": -3.703790
            }
        },
        "zoomLevel": {
            "type": "number",
            "default": 6
        },
        "cptSlug": {             
            "type": "string",
            "default": "location"  
        },
        "showList": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": [ "wide", "full" ]
    },
    "editorScript": "file:./index.js",
    "editorStyle":  "file:./editor.css",
    "style": "file:./style.css",
    "viewScript": "file:./view.js",
    "render": "file:../templates/map-container.php"
}