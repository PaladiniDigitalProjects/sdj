{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "pds-map-locations-filter/tienda-lista",
  "title": "Tienda Lista",
  "category": "widgets",
  "description": "Display a list of stores.",
  "textdomain": "pds-map-locations-filter",
  "icon": "store",
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title":               { "type": "string", "default": "Our Stores" },
    "displayStyle":        { "type": "string", "enum": ["grid", "list"], "default": "grid" },
    "numStores":           { "type": "number", "default": 8 },
    "selectedTaxonomies":  { "type": "array",  "items": { "type": "string" }, "default": ["ambito"] },
    "cptSlug":             { "type": "string",  "default": "location" } 
  },
  "editorScript":   "file:./index.js",
  "editorStyle":    "file:./editor.css",
  "script":         "file:./view.js",    
  "style":          "file:./style.css",
  "render": "file:../templates/tienda-lista.php"

}
