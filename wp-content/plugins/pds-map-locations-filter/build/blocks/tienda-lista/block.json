{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "pds-map-locations-filter/tienda-lista",
  "title": "Tienda Lista",
  "category": "widgets",
  "description": "Display a list of stores.",
  "textdomain": "pds-map-locations-filter",
  "icon": "store",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Our Stores"
    },
    "displayStyle": {
      "type": "string",
      "enum": ["grid", "list"],
      "default": "grid"
    },
    "numStores": {
      "type": "number",
      "default": 5
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./templates/tienda-lista.php"
}