msgid "Failed to import category %s"
msgstr "Ha fallat la importació de la categoria %s"

#: class-wp-import.php:373
msgid "as a new user:"
msgstr "com a usuari nou:"

#: class-wp-import.php:1417
msgid "Zero size file downloaded"
msgstr "S'ha baixat un fitxer de mida zero"

#: class-wp-import.php:287
msgid "Failed to import author %s. Their posts will be attributed to the current user."
msgstr "Ha fallat la importació de l'autor %s. Les seves entrades s'atribueixen a l'usuari actual."

#: class-wp-import.php:595
msgid "Failed to import post tag %s"
msgstr "Ha fallat la importació de l'etiqueta d'entrada %s"

