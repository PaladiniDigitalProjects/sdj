#. translators: %s is the underlying error message returned by wp_mail() / the
#. mailer (already localized or quoted verbatim from the mailer response).
#: src/WPCLI/Commands/Test.php:86
msgid "Test email failed: %s"
msgstr "Fallou o correo electrónico de proba: %s"

#: src/WPCLI/Commands/Test.php:81
msgid "wp_mail() returned false (no further detail available)."
msgstr "wp_mail() devolveu false (non hai máis detalles dispoñibles)."

#. translators: %1$s is the recipient email address. %2$s is the mailer slug
#. (e.g. smtp, sendgrid). Recipient and mailer slug are not translated.
#: src/WPCLI/Commands/Test.php:70
msgid "Test email sent to %1$s via mailer \"%2$s\"."
msgstr "Correo electrónico de proba enviado a %1$s mediante o servidor de correo «%2$s»."

#: src/WPCLI/Commands/Test.php:50
msgid "No mailer is configured. Run `wp wp-mail-smtp setup ...` first."
msgstr "Non hai ningún servidor de correo configurado. Executa primeiro `wp wp-mail-smtp setup ...`."

#: src/WPCLI/Commands/Test.php:44
msgid "Pass a valid recipient: wp wp-mail-smtp test <recipient>"
msgstr "Indica un destinatario válido: wp wp-mail-smtp test <recipient>"

#. translators: %s is the configured mailer slug (e.g. smtp, sendgrid). The
#. slug is not translated.
#: src/WPCLI/Commands/Setup.php:119
msgid "Configured WP Mail SMTP (mailer: %s). Run `wp wp-mail-smtp test <recipient>` to verify."
msgstr "WP Mail SMTP configurado (servidor de correo: %s). Executa `wp wp-mail-smtp test <recipient>` para comprobalo."

#: src/WPCLI/Commands/Setup.php:108
msgid "No settings were stored — every flag passed was shadowed by a wp-config constant. Remove the constants and re-run, or pass flags for non-shadowed settings."
msgstr "Non se gardou ningún axuste — todos os parámetros indicados estaban anulados por unha constante de wp-config. Elimina as constantes e volve executalo, ou pasa parámetros para axustes non anulados."

#: src/WPCLI/Commands/Setup.php:100
msgid "No configuration flags provided. Pass at least --mail.from_email, --mail.from_name, and --mail.mailer (plus the credentials for that mailer)."
msgstr "Non se indicou ningún parámetro de configuración. Pasa polo menos --mail.from_email, --mail.from_name e --mail.mailer (ademais das credenciais dese servidor de correo)."

#. translators: %s is the currently configured mailer slug (e.g. smtp,
#. sendgrid). The slug is not translated.
#: src/WPCLI/Commands/Setup.php:91
msgid ""
"WP Mail SMTP is already configured (mailer: %s).\n"
"Use `wp wp-mail-smtp option set <group>.<key> <value>` to change individual settings, or pass --force to override this check."
msgstr ""
"WP Mail SMTP xa está configurado (servidor de correo: %s).\n"
"Usa `wp wp-mail-smtp option set <group>.<key> <value>` para cambiar axustes individuais ou pasa --force para ignorar esta comprobación."

#: src/WPCLI/Commands/Setup.php:45
msgid "Skip the refusal that fires when the plugin is already configured. Does NOT wipe existing settings — only flags you pass are written."
msgstr "Omite o rexeitamento que se produce cando o plugin xa está configurado. NON borra os axustes existentes — só se escriben os parámetros que pases."

#: src/WPCLI/Commands/Setup.php:29
msgid "Configure WP Mail SMTP from the command line."
msgstr "Configura WP Mail SMTP desde a liña de comandos."

#. translators: %s is the dotted CLI flag that was updated (e.g. smtp.host).
#. The flag itself is not translated.
#: src/WPCLI/Commands/Option.php:263
