msgstr "Parámetro descoñecido: %s"

#: src/WPCLI/Commands/Option.php:148
msgid "Usage: wp wp-mail-smtp option get <group>.<key>"
msgstr "Uso: wp wp-mail-smtp option get <group>.<key>"

#: src/WPCLI/Commands/Option.php:125
msgid "Action must be one of: get, set, list."
msgstr "A acción debe ser unha destas: get, set, list."

#: src/WPCLI/Commands/Option.php:63
msgid "Output format for `list`. table | json | yaml. Default: table."
msgstr "Formato de saída para `list`. table | json | yaml. Por defecto: table."

#: src/WPCLI/Commands/Option.php:62
msgid "Show sensitive values instead of masking them."
msgstr "Mostra os valores sensibles en lugar de ocultalos."

#: src/WPCLI/Commands/Option.php:61
msgid "Read a sensitive value from a file."
msgstr "Le un valor sensible desde un arquivo."

#: src/WPCLI/Commands/Option.php:60
msgid "Value (required for set; can also be supplied via --value-file or env var)."
msgstr "Valor (obrigatorio para set; tamén se pode indicar mediante --value-file ou unha variable de contorno)."

#: src/WPCLI/Commands/Option.php:59
msgid "Dotted flag (e.g. smtp.host). Required for get and set."
msgstr "Parámetro con puntos (p. ex. smtp.host). Obrigatorio para get e set."

#: src/WPCLI/Commands/Option.php:58
msgid "One of: get, set, list."
msgstr "Un destes: get, set, list."

#: src/WPCLI/Commands/Option.php:42
msgid "Read and write individual WP Mail SMTP settings."
msgstr "Le e escribe axustes individuais de WP Mail SMTP."

