#: src/Providers/Sendlayer/QuickConnectUsage.php:578
msgid "You've reached your free SendLayer limit. Emails are failing and won't be delivered! <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Upgrade your plan</a> to start sending again."
msgstr "Acadaches o límite gratuíto de SendLayer. Os correos electrónicos están fallando e non se entregarán! <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">Actualiza o teu plan</a> para volver enviar."

