# -----------------------------------------------------------------------------
# WordPress Core (do not track, SiteGround provides WordPress)
# -----------------------------------------------------------------------------
wp-admin/
wp-includes/

# -----------------------------------------------------------------------------
# WordPress Content
# -----------------------------------------------------------------------------
# Ignore uploads (keep media on server)
wp-content/uploads/
!wp-content/uploads/.gitkeep

# Ignore cache, backups, exports, logs
wp-content/upgrade/
wp-content/backup-db/
# wp-content/cache/
# wp-content/cache/supercache/
wp-content/w3tc-cache/
wp-content/wflogs/
wp-content/uploads/alm_templates/
wp-content/uploads/searchwp-logs/
wp-content/uploads/wp-migrate-db/
wp-content/uploads/wpallexport/
wp-content/uploads/wpo/
wp-content/uploads/wpo-plugins-tables-list.json
wp-content/uploads/sgs_encrypt_key.php

# Ignore drop-in files generated by plugins
# wp-content/advanced-cache.php
# wp-content/db.php
# wp-content/object-cache.php

# -----------------------------------------------------------------------------
# Themes & Plugins
# -----------------------------------------------------------------------------
# Ignore all themes except child/custom ones
wp-content/themes/*
!wp-content/themes/twentytwentyfive-child/**
!wp-content/themes/PDP/**

# If you have custom plugins, whitelist them here
# wp-content/plugins/my-custom-plugin/**

# -----------------------------------------------------------------------------
# Sensitive files
# -----------------------------------------------------------------------------
**/.DS_Store
.DS_Store
.env*
/.well-known

# -----------------------------------------------------------------------------
# Development / Build files
# -----------------------------------------------------------------------------
node_modules/
vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# IDE / OS files
# -----------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db

# -----------------------------------------------------------------------------
# Local-only
# -----------------------------------------------------------------------------
.lando.local.yml
.env.local
.dockerignore
Dockerfile

# -----------------------------------------------------------------------------
# Custom folders (specific to your project)
# -----------------------------------------------------------------------------
/revistasanjuandedios14/
/revistasanjuandedios15/
/revistasanjuandedios16/
