# -----------------------------------------------------------------------------
# WordPress Core (do not track, SiteGround provides WordPress)
# -----------------------------------------------------------------------------
wp-admin/
wp-includes/

# -----------------------------------------------------------------------------
# WordPress Content
# -----------------------------------------------------------------------------
# Keep uploads on server; allow essential placeholder
wp-content/uploads/
!wp-content/uploads/2025/09
!wp-content/uploads/2025/10
!wp-content/uploads/2025/11
!wp-content/uploads/2025/12
!wp-content/uploads/.gitkeep
!wp-content/uploads/sgs_encrypt_key.php

# Cache, backups, exports, logs
wp-content/upgrade/
wp-content/backup-db/
wp-content/cache/
wp-content/cache/supercache/
wp-content/w3tc-cache/
wp-content/wflogs/
wp-content/uploads/alm_templates/
wp-content/uploads/searchwp-logs/
wp-content/uploads/wp-migrate-db/
wp-content/uploads/wpallexport/
wp-content/uploads/wpo/
wp-content/uploads/wpo-plugins-tables-list.json

